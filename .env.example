# Variables de entorno del POS.
#
# Copiá este archivo a .env y completá los valores. NO commitees .env.
#
# REGLA DE ORO
# Toda variable con prefijo VITE_ termina incrustada en el bundle del browser:
# es pública por diseño, para cualquiera que abra la app. Por eso
#   - nunca guardes una credencial privada con prefijo VITE_;
#   - no sirve de nada "protegerla" acá, se publica igual;
#   - el control de acceso se hace con las security rules de Firestore.
# Los secretos de verdad (service accounts, tokens de pago) no van en este
# archivo: viven en el backend, sin prefijo VITE_.

# Raíz de las colecciones del catálogo en Firestore. Formato: env/<entorno>.
# Sin valor por defecto a propósito: si falta, la app falla al arrancar en vez
# de conectarse en silencio a un catálogo equivocado.
VITE_CATALOG_ROOT=

# Config del proyecto Firebase para web. Pública por diseño; los valores reales
# salen de Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
